<templates xml:space="preserve">
    <t t-name="sales_rep_dashboard_template">
        <div class="o_sales_dashboard container-fluid h-100 overflow-auto">
            <div class="row pt-4 px-3">
                <div class="col-12">
                    <h2 class="mb-4 font-weight-bold">Sales Representative Dashboard</h2>
                </div>
            </div>

            <!-- Security Alerts -->
            <t t-if="state.data.security_alerts.length">
                <div class="mock-location-alert mx-3">
                    <div class="mock-alert-header">
                        <i class="fa fa-exclamation-triangle"/>
                        <div>
                            <div class="mock-alert-title">Security Alert</div>
                            <div class="mock-alert-subtitle">
                                The following sales representative(s) triggered a security alert (e.g. mock location, developer mode).
                            </div>
                        </div>
                        <button class="mock-alert-link" t-on-click="openSecurityAlerts">
                            View All
                        </button>
                    </div>
                    <div class="mock-alert-list">
                        <t t-foreach="state.data.security_alerts" t-as="alert" t-key="alert.rep_id">
                            <div class="mock-alert-item">
                                <div class="mock-alert-top">
                                    <div class="mock-alert-rep">
                                        <i class="fa fa-user-secret"/>
                                        <strong><t t-esc="alert.rep_name"/></strong>
                                    </div>

                                    <span class="mock-alert-tag">
                                        <i class="fa fa-user-secret"/>
                                        <t t-esc="alert.alert_type"/>
                                    </span>
                                </div>

                                <div class="mock-alert-meta">
                                    <span>
                                        Last detected:
                                        <t t-esc="formatAlertDate(alert.last_detected_at)"/>
                                    </span>

                                    <span t-if="alert.alert_count > 1">
                                        • <t t-esc="alert.alert_count"/> detections
                                    </span>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>

            <!-- Filter & Control -->
            <div class="filter-bar mx-3">
                <div class="filter-item">
                    <label>From Date</label>
                    <input type="date" t-model="state.date_from" t-on-change="refreshData"/>
                </div>
                <div class="filter-item">
                    <label>To Date</label>
                    <input type="date" t-model="state.date_to" t-on-change="refreshData"/>
                </div>
                <div class="filter-item">
                    <label>Sales Representative <i class="fa fa-question-circle text-muted" title="Filter by specific sales rep"/></label>
                    <select class="form-control" t-model="state.sales_rep_id" t-on-change="refreshData">
                        <option value="">All Representatives</option>
                        <t t-foreach="state.reps" t-as="rep" t-key="rep.id">
                            <option t-att-value="rep.id"><t t-esc="rep.name"/></option>
                        </t>
                    </select>
                </div>
                <button class="refresh-btn" t-on-click="refreshData">
                    <i class="fa fa-refresh"/>
                </button>
            </div>

            <!-- KPI Row -->
            <div class="kpi-row mx-3">
                <div class="kpi-card kpi-navy">
                    <div class="icon-box">
                        <i class="fa fa-road"/>
                    </div>
                    <div class="kpi-content">
                        <div class="kpi-label">Total Routes</div>
                        <div class="kpi-value"><t t-esc="state.data.kpis.total_routes"/></div>
                    </div>
                </div>
                <div class="kpi-card kpi-teal">
                    <div class="icon-box">
                        <i class="fa fa-users"/>
                    </div>
                    <div class="kpi-content">
                        <div class="kpi-label">Online Sales Reps</div>
                        <div class="kpi-value">
                            <t t-esc="state.data.online_count"/> / <t t-esc="state.data.total_devices"/>
                        </div>
                    </div>
                </div>
                <div class="kpi-card kpi-cyan">
                    <div class="icon-box">
                        <i class="fa fa-map-marker"/>
                    </div>
                    <div class="kpi-content">
                        <div class="kpi-label">Total Visits</div>
                        <div class="kpi-value"><t t-esc="state.data.kpis.total_visits"/></div>
                    </div>
                </div>
                <div class="kpi-card kpi-green">
                    <div class="icon-box">
                        <i class="fa fa-check-square-o"/>
                    </div>
                    <div class="kpi-content">
                        <div class="kpi-label">Completed Visits</div>
                        <div class="kpi-value"><t t-esc="state.data.kpis.completed_visits"/></div>
                    </div>
                </div>
            </div>

            <!-- Financial Row -->
            <div class="financial-row mx-3">
                <div class="financial-card">
                    <div class="icon-box icon-gold">
                        <i class="fa fa-money"/>
                    </div>
                    <div class="fin-content">
                        <div class="fin-label">Total Sales</div>
                        <div class="fin-value">$<t t-esc="formatCurrency(state.data.kpis.total_sales)"/></div>
                    </div>
                </div>
                <div class="financial-card">
                    <div class="icon-box icon-orange">
                        <i class="fa fa-credit-card"/>
                    </div>
                    <div class="fin-content">
                        <div class="fin-label">Total Payments</div>
                        <div class="fin-value">$<t t-esc="formatCurrency(state.data.kpis.total_payments)"/></div>
                    </div>
                </div>
                <div class="financial-card gauge-card">
                    <div class="fin-content">
                        <div class="fin-label">Payment Efficiency</div>
                        <div class="fin-value"><t t-esc="state.data.kpis.efficiency"/>%</div>
                    </div>
                    <div class="gauge-container">
                        <canvas t-ref="efficiencyGauge"></canvas>
                    </div>
                </div>
            </div>

            <!-- Chart Row -->
            <div class="chart-row mx-3">
                <div class="chart-container online-status-container" style="display: flex; flex-direction: column; padding: 24px; background: white; border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05); height: 380px; max-height: 380px; box-sizing: border-box; overflow: hidden;">
                    <h5 style="font-size: 16px; font-weight: 600; color: #2d3748; margin-bottom: 20px; text-align: left; display: flex; align-items: center; gap: 8px;">
                        <i class="fa fa-history" style="color: #64748b;"></i> Representative Session Log
                    </h5>
                    
                    <!-- Table / Scroll List -->
                    <div style="flex: 1; overflow-y: auto; text-align: left; border: 1px solid #f1f5f9; border-radius: 8px; width: 100%; max-height: 280px;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                            <thead>
                                <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #475569; font-weight: 600;">
                                    <th style="padding: 10px 12px; text-align: left;">Name</th>
                                    <th style="padding: 10px 12px; text-align: center;">State</th>
                                    <th style="padding: 10px 12px; text-align: right;">Date/Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="state.data.session_logs_data and state.data.session_logs_data.length > 0">
                                    <t t-foreach="state.data.session_logs_data" t-as="log" t-key="log.id">
                                        <tr style="border-bottom: 1px solid #f1f5f9; color: #334155; transition: background 0.15s;">
                                            <td style="padding: 10px 12px; font-weight: 500;"><t t-esc="log.rep_name"/></td>
                                            <td style="padding: 10px 12px; text-align: center;">
                                                <t t-if="log.action_type == 'login'">
                                                    <span style="background: rgba(16, 185, 129, 0.15); color: #059669; padding: 2px 8px; border-radius: 20px; font-size: 11px; font-weight: 600; display: inline-block;">Logged In</span>
                                                </t>
                                                <t t-elif="log.action_type == 'logout'">
                                                    <span style="background: rgba(239, 68, 68, 0.15); color: #dc2626; padding: 2px 8px; border-radius: 20px; font-size: 11px; font-weight: 600; display: inline-block;">Logged Out</span>
                                                </t>
                                                <t t-else="">
                                                    <span style="background: rgba(245, 158, 11, 0.15); color: #d97706; padding: 2px 8px; border-radius: 20px; font-size: 11px; font-weight: 600; display: inline-block;">Forced Out</span>
                                                </t>
                                            </td>
                                            <td style="padding: 10px 12px; text-align: right; color: #64748b; font-size: 12px;"><t t-esc="formatAlertDate(log.timestamp)"/></td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td colspan="3" style="padding: 30px; text-align: center; color: #94a3b8; font-style: italic;">
                                            <i class="fa fa-info-circle" style="margin-right: 5px;"></i> No logs found in this range
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="chart-container">
                    <h5>Visit Completion Rate</h5>
                    <div class="chart-wrapper">
                        <canvas t-ref="visitChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Footer Actions -->
            <div class="footer-actions mx-3">
                <button class="btn-dash btn-purple" t-on-click="() => this.openAction('sales.rep.route')">
                    <i class="fa fa-road text-white mr-2"/> View Routes
                </button>
                <button class="btn-dash btn-navy" t-on-click="() => this.openAction('sales.rep.visit')">
                    <i class="fa fa-users text-white mr-2"/> View Visits
                </button>
                <button class="btn-dash btn-forest" t-on-click="() => this.openAction('account.payment')">
                    <i class="fa fa-credit-card text-white mr-2"/> View Payments
                </button>
            </div>
        </div>
    </t>
</templates>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Wizard Form View -->
        <record id="view_sales_rep_session_report_wizard_form" model="ir.ui.view">
            <field name="name">sales.rep.session.report.wizard.form</field>
            <field name="model">sales.rep.session.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Representative Device Session Report">
                    <group>
                        <group>
                            <field name="from_date"/>
                            <field name="to_date"/>
                            <field name="sales_rep_ids" widget="many2many_tags" placeholder="All Representatives if empty"/>
                        </group>
                        <group>
                            <field name="action_filter"/>
                            <field name="export_format"/>
                        </group>
                    </group>
                    <footer>
                        <button name="generate_report" string="Generate Report" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Wizard Action -->
        <record id="action_sales_rep_session_report_wizard" model="ir.actions.act_window">
            <field name="name">Representative Session Report</field>
            <field name="res_model">sales.rep.session.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_sales_rep_session_report"
                  name="Representative Session Report"
                  parent="menu_sales_rep_reports"
                  action="action_sales_rep_session_report_wizard"
                  sequence="5"/>
    </data>
</odoo>

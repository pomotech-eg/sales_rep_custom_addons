<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sales_rep_security_alert_list" model="ir.ui.view">
            <field name="name">sales.rep.security.alert.list</field>
            <field name="model">sales.rep.security.alert</field>
            <field name="arch" type="xml">
                <list string="Security Alerts"
                      create="false"
                      edit="false"
                      decoration-muted="active == False">
                    <field name="detected_at"/>
                    <field name="sales_rep_id"/>
                    <field name="alert_type"/>
                    <field name="latitude"/>
                    <field name="longitude"/>
                    <field name="accuracy"/>
                    <field name="device_identifier"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="active" widget="boolean_toggle"/>
                    <button name="action_dismiss"
                            type="object"
                            string="Dismiss"
                            icon="fa-check"
                            invisible="not active"
                            groups="sales_rep_management.group_sales_manager,sales_rep_management.group_sales_supervisor"/>
                </list>
            </field>
        </record>

        <record id="view_sales_rep_security_alert_form" model="ir.ui.view">
            <field name="name">sales.rep.security.alert.form</field>
            <field name="model">sales.rep.security.alert</field>
            <field name="arch" type="xml">
                <form string="Security Alert" create="false" edit="false">
                    <header>
                        <button name="action_dismiss"
                                type="object"
                                string="Dismiss from Dashboard"
                                class="btn-primary"
                                invisible="not active"
                                groups="sales_rep_management.group_sales_manager,sales_rep_management.group_sales_supervisor"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Dismissed" bg_color="text-bg-secondary" invisible="active"/>
                        <group>
                            <group>
                                <field name="sales_rep_id"/>
                                <field name="alert_type"/>
                                <field name="detected_at"/>
                                <field name="device_identifier"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="latitude"/>
                                <field name="longitude"/>
                                <field name="accuracy"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_sales_rep_security_alert_search" model="ir.ui.view">
            <field name="name">sales.rep.security.alert.search</field>
            <field name="model">sales.rep.security.alert</field>
            <field name="arch" type="xml">
                <search string="Security Alerts">
                    <field name="sales_rep_id"/>
                    <field name="device_identifier"/>
                    <field name="detected_at"/>
                    <field name="alert_type"/>
                    <filter string="Active Alerts" name="active_alerts" domain="[('active', '=', True)]"/>
                    <filter string="Dismissed" name="dismissed_alerts" domain="[('active', '=', False)]"/>
                    <separator/>
                    <filter string="Mock Location" name="mock_location" domain="[('alert_type', '=', 'mock_location')]"/>
                    <filter string="Developer Mode" name="developer_mode" domain="[('alert_type', '=', 'developer_mode')]"/>
                    <separator/>
                    <filter string="Today" name="today"
                            domain="[('detected_at', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                    <group expand="0" string="Group By">
                        <filter string="Sales Representative" name="group_rep" context="{'group_by': 'sales_rep_id'}"/>
                        <filter string="Alert Type" name="group_type" context="{'group_by': 'alert_type'}"/>
                        <filter string="Detection Date" name="group_date" context="{'group_by': 'detected_at:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_sales_rep_security_alert" model="ir.actions.act_window">
            <field name="name">Security Alerts</field>
            <field name="res_model">sales.rep.security.alert</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active_alerts': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No security alerts found.
                </p>
                <p>
                    Alerts are created automatically when the mobile app detects
                    security issues such as fake GPS (mock location) or developer mode.
                </p>
                <p>
                    Active alerts appear on the dashboard for the selected date range.
                    Dismiss an alert to remove it from the dashboard while keeping the history.
                </p>
            </field>
        </record>

        <menuitem id="menu_sales_rep_security_alerts"
                  name="Security Alerts"
                  parent="menu_sales_rep_config"
                  action="action_sales_rep_security_alert"
                  sequence="15"
                  groups="sales_rep_management.group_sales_manager,sales_rep_management.group_sales_supervisor"/>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.sales.rep</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="90"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Sales Rep Management" string="Sales Rep Management" name="sales_rep_management" groups="sales_rep_management.group_sales_manager">
                        <block title="Sales Rep Location Setting" name="sales_rep_location_setting">
                           <setting id="location_tracking_setting" help="Enable or disable location tracking for sales representatives.">
                                <field name="is_location_tracking_enabled"/>
                                
                                <div class="content-group" invisible="not is_location_tracking_enabled">
                                    <div class="row mt16">
                                        <div class="col-12 d-flex align-items-center mb-2">
                                            <field name="location_restriction" class="me-2"/>
                                            <label for="location_restriction" class="o_light_label m-0"/>
                                        </div>
                                        
                                        <div class="col-12 text-muted mb-3 ps-4">
                                            Enable or disable the tracking of customer locations during visits.
                                        </div>
                                        
                                        <div invisible="not location_restriction" class="col-12 ps-4">
                                            <div class="row g-2 align-items-center">
                                                <div class="col-auto">
                                                    <label for="location_radius" class="o_light_label m-0"/>
                                                </div>
                                                <div class="col-sm-6 col-md-4">
                                                    <field name="location_radius"/>
                                                </div>
                                                <div class="col-12 text-muted small mt-1">
                                                    Default radius around the customer location (meters)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </setting>
                            <field name="is_hr_contract_installed" invisible="1"/>

                            <setting id="hr_contract_setting"
                                    help="Enable or disable HR contract deactivation." invisible="not is_hr_contract_installed">
                                <field name="hr_contract_deactive"/>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>

        <record id="action_sales_rep_config_settings" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module' : 'sales_rep_management', 'bin_size': False}</field>
        </record>

        <menuitem id="menu_sales_rep_config_settings"
            name="Settings"
            parent="sales_rep_management.menu_sales_rep_config"
            sequence="0"
            action="action_sales_rep_config_settings"
            groups="sales_rep_management.group_sales_manager"/>
    </data>
</odoo>

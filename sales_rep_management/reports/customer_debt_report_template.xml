<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_customer_debt_report">
        <t t-call="web.html_container">
            <t t-set="o" t-value="docs[0] if docs else env['customer.debt.report.wizard'].browse(doc_ids[0]) if doc_ids else False"/>
            <t t-set="partners" t-value="env['res.partner'].sudo().browse(partner_ids) if partner_ids else o.get_debt_data() if o else []"/>
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="text-center mt32">
                        <h2>Customer Debt Report</h2>
                        <div class="row">
                            <div class="col-12">
                                <strong>Sales Representatives: </strong> 
                                <span t-esc="o.get_sales_rep_names() if o else 'All'"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <strong>Date: </strong> 
                                <span t-esc="env['customer.debt.report.wizard'].get_today_date()"/>
                            </div>
                        </div>
                    </div>

                    <table class="table table-sm mt32">
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th class="text-right">Amount Due</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="total_debt" t-value="0.0"/>
                            <t t-foreach="partners" t-as="partner">
                                <tr>
                                    <td><span t-field="partner.name"/></td>
                                    <td class="text-right">
                                        <span t-esc="'%.2f' % partner._get_total_due()"/>
                                        <t t-set="total_debt" t-value="total_debt + partner._get_total_due()"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="border-black font-weight-bold">
                                <td>Total</td>
                                <td class="text-right">
                                    <span t-esc="total_debt" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_customer_debt_report" model="ir.actions.report">
        <field name="name">Customer Debt Report</field>
        <field name="model">customer.debt.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sales_rep_management.report_customer_debt_report</field>
        <field name="report_file">sales_rep_management.report_customer_debt_report</field>
    </record>
</odoo>

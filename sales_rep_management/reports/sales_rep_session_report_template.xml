<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Report Action -->
        <record id="action_sales_rep_session_pdf_report" model="ir.actions.report">
            <field name="name">Representative Session Report</field>
            <field name="model">sales.rep.session.report.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sales_rep_management.report_sales_rep_session_wizard</field>
            <field name="report_file">sales_rep_management.report_sales_rep_session_wizard</field>
            <field name="binding_model_id" ref="model_sales_rep_session_report_wizard"/>
            <field name="binding_type">report</field>
        </record>

        <!-- Main Template -->
        <template id="report_sales_rep_session_wizard">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div class="oe_structure"/>
                            
                            <div class="text-center" style="margin-bottom: 25px;">
                                <h2 style="color: #1e3a8a; font-weight: 700;">Representative Device Session Report</h2>
                                <p style="font-size: 13px; color: #4b5563;">
                                    <strong>Period:</strong> 
                                    <span t-field="o.from_date"/> to <span t-field="o.to_date"/>
                                </p>
                            </div>

                            <div class="mt-4">
                                <table class="table table-sm table-striped" style="font-size: 11px;">
                                    <thead style="background-color: #f3f4f6;">
                                        <tr>
                                            <th>Rep Code</th>
                                            <th>Representative Name</th>
                                            <th>Session Reference</th>
                                            <th>Action Type</th>
                                            <th>Time</th>
                                            <th>Duration</th>
                                            <th>Device Model</th>
                                            <th>MAC Address</th>
                                            <th>View on Map</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                         <t t-set="logs_data" t-value="o.get_report_logs_data()"/>
                                         <t t-set="logs" t-value="logs_data[0]"/>
                                         <t t-set="duration_info" t-value="logs_data[1]"/>
                                         <t t-foreach="logs" t-as="log">
                                             <tr>
                                                 <td><span t-field="log.sales_rep_id.code"/></td>
                                                 <td><span t-field="log.sales_rep_id.name"/></td>
                                                 <td><span t-field="log.session_sequence"/></td>
                                                 <td>
                                                     <span t-if="log.action_type == 'login'" class="badge bg-success" style="padding: 3px 6px;">Login</span>
                                                     <span t-else="" class="badge bg-danger" style="padding: 3px 6px;">Logout</span>
                                                 </td>
                                                 <td><span t-field="log.timestamp"/></td>
                                                 
                                                 <!-- Duration Column with Rowspan -->
                                                 <t t-set="info" t-value="duration_info.get(log.id, {'rowspan': 1, 'value': '', 'skip': False})"/>
                                                 <td t-if="not info['skip']" t-att-rowspan="info['rowspan']" class="text-center align-middle" style="font-weight: bold; vertical-align: middle; text-align: center;">
                                                     <span t-out="info['value']"/>
                                                 </td>
                                                 
                                                 <td><span t-field="log.device_model"/></td>
                                                 <td><span t-field="log.mac_address"/></td>
                                                 <td>
                                                     <a t-if="log.latitude and log.longitude" t-attf-href="https://www.google.com/maps/search/?api=1&amp;query={{log.latitude}},{{log.longitude}}" target="_blank">View on Map</a>
                                                 </td>
                                             </tr>
                                         </t>
                                    </tbody>
                                </table>
                            </div>

                            <div class="oe_structure"/>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>

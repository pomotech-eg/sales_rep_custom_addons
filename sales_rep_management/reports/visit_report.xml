<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Visit Report Template (Document layout for a single record 'o') -->
        <template id="report_visit_document">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="row">
                        <div class="col-12">
                            <h2>Visit Report</h2>
                        </div>
                    </div>
                    
                    <div class="row mt32">
                        <div class="col-6">
                            <strong>Visit Reference:</strong> <span t-field="o.name"/><br/>
                            <strong>Customer:</strong> <span t-field="o.partner_id.name"/><br/>
                            <strong>Visit Type:</strong> <span t-field="o.visit_type"/><br/>
                            <strong>Sales Representative:</strong> <span t-field="o.route_id.sales_rep_id.name"/><br/>
                        </div>
                        <div class="col-6">
                            <strong>Planned Time:</strong> <span t-field="o.planned_time" t-options="{'widget': 'datetime'}"/><br/>
                            <strong>Actual Time:</strong> <span t-field="o.visit_time" t-options="{'widget': 'datetime'}"/><br/>
                            <strong>Duration:</strong> <span t-field="o.duration"/> hours<br/>
                            <strong>Status:</strong> <span t-field="o.state"/><br/>
                        </div>
                    </div>

                    <div class="row mt32" t-if="o.visit_result">
                        <div class="col-12">
                            <h4>Visit Results</h4>
                            <p><strong>Result:</strong> <span t-field="o.visit_result"/></p>
                            <p t-if="o.sale_amount"><strong>Sale Amount:</strong> <span t-field="o.sale_amount" t-options="{'widget': 'monetary', 'display_currency': o.route_id.company_id.currency_id or res_company.currency_id}"/></p>
                            <p t-if="o.total_collected"><strong>Collections:</strong> <span t-field="o.total_collected" t-options="{'widget': 'monetary', 'display_currency': o.route_id.company_id.currency_id or res_company.currency_id}"/></p>
                        </div>
                    </div>

                    <div class="row mt32" t-if="o.notes">
                        <div class="col-12">
                            <h4>Visit Notes</h4>
                            <p t-field="o.notes"/>
                        </div>
                    </div>

                    <div class="row mt32" t-if="o.payment_ids">
                        <div class="col-12">
                            <h4>Payments Collected</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Payment Ref</th>
                                        <th>Amount</th>
                                        <th>Payment Method (Journal)</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.payment_ids" t-as="payment">
                                        <td><span t-field="payment.name"/></td>
                                        <td><span t-field="payment.amount" t-options="{'widget': 'monetary', 'display_currency': payment.currency_id}"/></td>
                                        <td><span t-field="payment.journal_id.name"/></td>
                                        <td><span t-field="payment.state"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="row mt32" t-if="o.image_ids">
                        <div class="col-12">
                            <h4>Visit Images</h4>
                            <div class="row">
                                <div class="col-3" t-foreach="o.image_ids" t-as="image">
                                    <div class="card">
                                        <img t-att-src="image_data_uri(image.image)" class="card-img-top" style="height: 150px; object-fit: cover;"/>
                                        <div class="card-body p-2">
                                            <p class="card-text small"><span t-field="image.name"/></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt32" t-if="o.follow_up_required">
                        <div class="col-12">
                            <h4>Follow-up Required</h4>
                            <p><strong>Next Visit Date:</strong> <span t-field="o.next_visit_date"/></p>
                            <p t-if="o.follow_up_notes"><strong>Follow-up Notes:</strong> <span t-field="o.follow_up_notes"/></p>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Visit Report Container (Iterates over 'docs' list to set up the 'o' context variable) -->
        <template id="report_visit">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="sales_rep_management.report_visit_document" t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </template>

        <!-- Visit Report Action -->
        <record id="action_report_visit" model="ir.actions.report">
            <field name="name">Visit Report</field>
            <field name="model">sales.rep.visit</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sales_rep_management.report_visit</field>
            <field name="report_file">sales_rep_management.report_visit</field>
            <field name="binding_model_id" ref="model_sales_rep_visit"/>
            <field name="binding_type">report</field>
            <field name="binding_view_types">form</field>
        </record>

        <template id="report_visits_summary">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-size: 11px; padding: 20px;">
                        <!-- Custom Table-Based Header to guarantee perfect rendering in wkhtmltopdf -->
                        <table style="width: 100%; border-collapse: collapse; border-bottom: 2px solid #dee2e6; margin-bottom: 30px;">
                            <tr>
                                <td style="width: 50%; vertical-align: middle; padding-bottom: 15px; text-align: left;">
                                    <t t-if="res_company.logo">
                                        <img t-att-src="image_data_uri(res_company.logo)" style="max-height: 55px; float: left; margin-right: 12px;"/>
                                    </t>
                                    <div style="float: left; line-height: 1.25;">
                                        <h4 style="margin: 0; font-weight: bold; color: #111; font-size: 16px;"><span t-field="res_company.name"/></h4>
                                        <span t-if="res_company.city" style="color: #666; font-size: 11px;"><span t-field="res_company.city"/>, </span>
                                        <span t-if="res_company.country_id" style="color: #666; font-size: 11px;"><span t-field="res_company.country_id.name"/></span>
                                    </div>
                                    <div style="clear: both;"/>
                                </td>
                                <td style="width: 50%; text-align: right; vertical-align: middle; padding-bottom: 15px;">
                                    <h2 style="margin: 0; font-weight: bold; color: #d1a13b; font-size: 22px;">Customer Visits Summary Report</h2>
                                    <p class="text-muted" style="margin: 3px 0 0 0; font-size: 11px;">
                                        Generated: <span t-esc="datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/> | Total Selected Visits: <span t-esc="len(docs)"/>
                                    </p>
                                </td>
                            </tr>
                        </table>


                        <!-- Data Table -->
                        <table class="table table-sm table-striped" style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="border-bottom: 2px solid #dee2e6;">
                                    <th>Ref</th>
                                    <th>Sales Rep</th>
                                    <th>Route</th>
                                    <th>Customer</th>
                                    <th>Start Time</th>
                                    <th>End Time</th>
                                    <th>Duration</th>
                                    <th>Result</th>
                                    <th class="text-end">Sale Amount</th>
                                    <th class="text-end">Collected</th>
                                    <th class="text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="total_sales" t-value="0.0"/>
                                <t t-set="total_collected_amt" t-value="0.0"/>
                                <t t-foreach="docs" t-as="visit">
                                    <tr style="border-bottom: 1px solid #dee2e6;">
                                        <td><strong t-field="visit.name"/></td>
                                        <td><span t-field="visit.route_id.sales_rep_id.name"/></td>
                                        <td><span t-field="visit.route_id.name"/></td>
                                        <td><span t-field="visit.partner_id.name"/></td>
                                        <td><span t-field="visit.planned_time" t-options="{'widget': 'datetime', 'format': 'MM/dd/yyyy HH:mm'}"/></td>
                                        <td><span t-field="visit.visit_time" t-options="{'widget': 'datetime', 'format': 'MM/dd/yyyy HH:mm'}"/></td>
                                        <td>
                                            <t t-if="visit.duration">
                                                <t t-set="total_sec" t-value="int(abs(visit.duration) * 3600)"/>
                                                <t t-set="h" t-value="total_sec // 3600"/>
                                                <t t-set="m" t-value="(total_sec % 3600) // 60"/>
                                                <t t-set="s" t-value="total_sec % 60"/>
                                                <span t-esc="f'{h:02d}:{m:02d}:{s:02d}'"/>
                                            </t>
                                            <t t-else="">
                                                <span>00:00:00</span>
                                            </t>
                                        </td>
                                        <td><span t-field="visit.visit_result"/></td>
                                        <td class="text-end">
                                            <span t-field="visit.sale_amount" t-options="{'widget': 'monetary', 'display_currency': visit.route_id.company_id.currency_id or res_company.currency_id}"/>
                                            <t t-set="total_sales" t-value="total_sales + visit.sale_amount"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="visit.total_collected" t-options="{'widget': 'monetary', 'display_currency': visit.route_id.company_id.currency_id or res_company.currency_id}"/>
                                            <t t-set="total_collected_amt" t-value="total_collected_amt + visit.total_collected"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-field="visit.state" widget="badge"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Final Non-Repeating Summary Table (Placed outside the table to print only once at the end) -->
                        <div class="row justify-content-end mt32" style="page-break-inside: avoid;">
                            <div class="col-4 float-end" style="width: 33.33%; margin-left: auto;">
                                <table class="table table-sm" style="font-weight: bold; border-top: 2px solid #000; background-color: #f8f9fa;">
                                    <tr>
                                        <td style="padding: 6px;">Total Selected Visits:</td>
                                        <td class="text-end" style="padding: 6px;"><t t-esc="len(docs)"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 6px;">Total Sales Amount:</td>
                                        <td class="text-end" style="padding: 6px;">
                                            <span t-esc="total_sales" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr style="border-bottom: 2px solid #000;">
                                        <td style="padding: 6px; color: #28a745;">Total Collected:</td>
                                        <td class="text-end" style="padding: 6px; color: #28a745;">
                                            <span t-esc="total_collected_amt" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>

        <record id="paperformat_visits_summary" model="report.paperformat">
            <field name="name">Visits Summary Landscape</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_report_visits_summary" model="ir.actions.report">
            <field name="name">Visits Summary Report</field>
            <field name="model">sales.rep.visit</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sales_rep_management.report_visits_summary</field>
            <field name="report_file">sales_rep_management.report_visits_summary</field>
            <field name="binding_model_id" ref="model_sales_rep_visit"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="sales_rep_management.paperformat_visits_summary"/>
            <field name="binding_view_types">list</field>
        </record>


    </data>
</odoo>
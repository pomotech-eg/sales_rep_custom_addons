<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sales_report">
        <t t-call="web.html_container">
            <t t-set="o" t-value="docs[0] if docs else env['sales.report.wizard'].browse(doc_ids[0]) if doc_ids else False"/>
            <t t-set="orders" t-value="orders if orders else o.get_orders() if o else []"/>
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="text-center mt32">
                        <h2>Sales Report</h2>
                        <div class="row">
                            <div class="col-12">
                                <strong>Sales Representatives: </strong> 
                                <span t-esc="sales_rep_names if sales_rep_names else o.get_sales_rep_names() if o else 'All'"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <strong>Period: </strong> 
                                <t t-if="o">
                                    <span t-field="o.date_from"/> to <span t-field="o.date_to"/>
                                </t>
                                <t t-else="">
                                    <span t-esc="form.get('date_from')"/> to <span t-esc="form.get('date_to')"/>
                                </t>
                            </div>
                        </div>
                    </div>

                    <table class="table table-sm table-reports mt32">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th t-if="not o or len(o.sales_rep_ids) != 1">Sales Rep</th>
                                <th>Sales Order</th>
                                <th>Customer</th>
                                <th class="text-right">Total before Sales Rep allowed Discount</th>
                                <th class="text-right">Sales Rep allowed Discount</th>
                                <th class="text-right">Total after Sales Rep allowed Discount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="total_before" t-value="0.0"/>
                            <t t-set="total_discount" t-value="0.0"/>
                            <t t-set="total_after" t-value="0.0"/>
                            
                            <t t-foreach="orders" t-as="order">
                                <tr>
                                    <td><span t-field="order.date_order" t-options="{'widget': 'date'}"/></td>
                                    <td t-if="not o or len(o.sales_rep_ids) != 1"><span t-field="order.sales_rep_id.name"/></td>
                                    <td><span t-field="order.name"/></td>
                                    <td><span t-field="order.partner_id.name"/></td>
                                    <td class="text-right">
                                        <t t-set="before" t-value="order.amount_total + order.discount_total"/>
                                        <span t-esc="before" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                        <t t-set="total_before" t-value="total_before + before"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="order.discount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                        <t t-set="total_discount" t-value="total_discount + order.discount_total"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                        <t t-set="total_after" t-value="total_after + order.amount_total"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="border-black font-weight-bold">
                                <td t-att-colspan="4 if not o or len(o.sales_rep_ids) != 1 else 3">Total</td>
                                <td class="text-right">
                                    <span t-esc="total_before" t-options="{'widget': 'monetary', 'display_currency': orders[0].currency_id if orders else res_company.currency_id}"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="total_discount" t-options="{'widget': 'monetary', 'display_currency': orders[0].currency_id if orders else res_company.currency_id}"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="total_after" t-options="{'widget': 'monetary', 'display_currency': orders[0].currency_id if orders else res_company.currency_id}"/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_sales_report" model="ir.actions.report">
        <field name="name">Sales Report</field>
        <field name="model">sales.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sales_rep_management.report_sales_report</field>
        <field name="report_file">sales_rep_management.report_sales_report</field>
    </record>
</odoo>

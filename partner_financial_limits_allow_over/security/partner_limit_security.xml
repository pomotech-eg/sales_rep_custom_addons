<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Security Category -->
        <record id="module_category_partner_financial_limits" model="ir.module.category">
            <field name="name">Partner Financial Limits</field>
            <field name="description">حدود الاستحقاق المالي للشركاء</field>
            <field name="sequence">100</field>
        </record>

        <!-- Group: Allow Exceed Partner Limit -->
        <record id="group_exceed_partner_limit" model="res.groups">
            <field name="name">Allow Exceed Partner Limit</field>
            <field name="comment">
                السماح بتجاوز حدود الاستحقاق للشركاء
                
                Users in this group can confirm Sales Orders, Purchase Orders, 
                and post Invoices/Bills even when the partner's financial limit 
                has been exceeded.
                
                المستخدمون في هذه المجموعة يمكنهم تأكيد أوامر البيع والشراء 
                وترحيل الفواتير حتى عند تجاوز حد الاستحقاق المالي للشريك.
            </field>
            <field name="category_id" ref="module_category_partner_financial_limits"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Group: Manage Partner Limits -->
        <record id="group_manage_partner_limits" model="res.groups">
            <field name="name">Manage Partner Financial Limits</field>
            <field name="comment">
                إدارة حدود الاستحقاق المالي للشركاء
                
                Users in this group can set and modify the sale credit limit 
                and purchase debit limit on partner records.
                
                المستخدمون في هذه المجموعة يمكنهم تعيين وتعديل حدود الاستحقاق 
                في المبيعات والمشتريات على سجلات الشركاء.
            </field>
            <field name="category_id" ref="module_category_partner_financial_limits"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>

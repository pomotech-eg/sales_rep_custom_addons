<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
        <!-- Customer Invoice Form View - Add Credit Limit Info -->
        <!-- ═══════════════════════════════════════════════════════════════════════════ -->

        <record id="view_invoice_form_credit_limit" model="ir.ui.view">
            <field name="name">account.move.form.credit.limit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="priority">50</field>
            <field name="arch" type="xml">
                <!-- Warning Banner for Draft Invoices/Bills - Positioned at the top of the form -->
                <xpath expr="//sheet" position="before">
                    <div class="alert alert-warning text-center mb-0" role="alert"
                         invisible="not show_financial_warning">
                        <field name="financial_limit_warning" readonly="1"/>
                    </div>
                </xpath>

                <!-- Financial Limit Information -->
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="show_financial_warning" invisible="1"/>
                    <field name="partner_financial_limit" 
                           widget="monetary"       
                           readonly="1"
                           invisible="not partner_financial_limit"
                           string="Partner Limit"/>
                    <field name="partner_financial_used" 
                           widget="monetary" 
                           readonly="1"
                           invisible="not partner_financial_limit"
                           string="Amount Used"/>
                    <field name="partner_financial_available" 
                           widget="monetary" 
                           readonly="1"
                           invisible="not partner_financial_limit"
                           string="Amount Available"/>
                </xpath>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
        <!-- Invoice/Bill List View - Add Limit Status -->
        <!-- ═══════════════════════════════════════════════════════════════════════════ -->

        <record id="view_invoice_list_financial_limit" model="ir.ui.view">
            <field name="name">account.move.list.financial.limit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="priority">50</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_date']" position="after">
                    <field name="partner_financial_available" 
                           widget="monetary" 
                           optional="hide"
                           string="Limit Available"/>
                </xpath>
            </field>
        </record>

        <!-- Vendor Bill List View -->
        <record id="view_vendor_bill_list_financial_limit" model="ir.ui.view">
            <field name="name">account.move.list.vendor.bill.financial.limit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
            <field name="priority">50</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_date']" position="after">
                    <field name="partner_financial_available" 
                           widget="monetary" 
                           optional="hide"
                           string="Limit Available"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>

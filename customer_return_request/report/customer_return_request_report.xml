<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_customer_return_request" model="ir.actions.report">
        <field name="name">Customer Return Request</field>
        <field name="model">customer.return.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">customer_return_request.report_customer_return_document</field>
        <field name="report_file">customer_return_request.report_customer_return_document</field>
        <field name="print_report_name">'Return - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_customer_return_request"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_customer_return_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            Customer Return Request
                            <span t-field="o.name"/>
                        </h2>
                        <div class="row mt-4">
                            <div class="col-6">
                                <strong>Customer:</strong>
                                <span t-field="o.partner_id"/><br/>
                                <strong>Destination Location:</strong>
                                <span t-field="o.location_dest_id"/><br/>
                                <strong>Return Reason:</strong>
                                <span t-field="o.reason_id"/>
                            </div>
                            <div class="col-6">
                                <strong>Return Date:</strong>
                                <span t-field="o.return_date"/><br/>
                                <strong>Reference:</strong>
                                <span t-field="o.reference"/><br/>
                                <strong>Status:</strong>
                                <span t-field="o.state"/>
                            </div>
                        </div>

                        <table class="table table-sm o_main_table mt-4">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Quantity</th>
                                    <th>UoM</th>
                                    <th>Lot/Serial</th>
                                    <th class="text-end">Inv. Unit Cost</th>
                                    <th class="text-end">Credit Price</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-field="line.product_id"/></td>
                                    <td class="text-end">
                                        <span t-field="line.quantity"/>
                                    </td>
                                    <td><span t-field="line.product_uom_id"/></td>
                                    <td><span t-field="line.lot_id"/></td>
                                    <td class="text-end">
                                        <span t-field="line.inventory_unit_cost"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.credit_note_unit_price"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.price_subtotal"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row">
                            <div class="col-6 offset-6">
                                <table class="table table-sm">
                                    <tr>
                                        <td><strong>Total Quantity</strong></td>
                                        <td class="text-end">
                                            <span t-field="o.total_qty"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Total Inventory Value</strong></td>
                                        <td class="text-end">
                                            <span t-field="o.total_inventory_value"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Total Credit Amount</strong></td>
                                        <td class="text-end">
                                            <span t-field="o.total_credit_amount"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <p t-if="o.manager_notes" class="mt-3">
                            <strong>Manager Notes:</strong><br/>
                            <span t-field="o.manager_notes"/>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>

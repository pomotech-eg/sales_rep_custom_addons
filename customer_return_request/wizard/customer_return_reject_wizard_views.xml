<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_customer_return_reject_wizard_form" model="ir.ui.view">
        <field name="name">customer.return.reject.wizard.form</field>
        <field name="model">customer.return.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Return Request">
                <field name="request_id" invisible="1"/>
                <group>
                    <field name="reason"
                           placeholder="Explain why this request is rejected..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" type="object"
                            string="Reject" class="btn-danger"/>
                    <button string="Discard" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

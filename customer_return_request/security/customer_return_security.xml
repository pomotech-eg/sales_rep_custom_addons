<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================ -->
        <!-- Module category                                              -->
        <!-- ============================================================ -->
        <record id="module_category_customer_return" model="ir.module.category">
            <field name="name">Customer Returns</field>
            <field name="description">Customer return requests management</field>
            <field name="sequence">20</field>
        </record>

        <!-- ============================================================ -->
        <!-- Security groups                                              -->
        <!-- ============================================================ -->
        <record id="group_customer_return_user" model="res.groups">
            <field name="name">Customer Return User</field>
            <field name="category_id" ref="module_category_customer_return"/>
            <field name="comment">Create, edit (draft only) and submit return
                requests; read only their own requests.</field>
        </record>

        <record id="group_customer_return_manager" model="res.groups">
            <field name="name">Customer Return Manager</field>
            <field name="category_id" ref="module_category_customer_return"/>
            <field name="implied_ids"
                   eval="[(4, ref('group_customer_return_user'))]"/>
            <field name="users"
                   eval="[(4, ref('base.user_admin'))]"/>
            <field name="comment">Read all requests; approve, reject, cancel,
                reset to draft, edit approval information and manage
                configuration.</field>
        </record>

        <!-- ============================================================ -->
        <!-- Record rules - Return Request                                -->
        <!-- ============================================================ -->
        <record id="rule_return_request_user_own" model="ir.rule">
            <field name="name">Customer Return: user sees only own requests</field>
            <field name="model_id" ref="model_customer_return_request"/>
            <field name="groups"
                   eval="[(4, ref('group_customer_return_user'))]"/>
            <field name="domain_force">['|', ('requested_by', '=', user.id), ('create_uid', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_return_request_manager_all" model="ir.rule">
            <field name="name">Customer Return: manager sees all requests</field>
            <field name="model_id" ref="model_customer_return_request"/>
            <field name="groups"
                   eval="[(4, ref('group_customer_return_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_return_request_company" model="ir.rule">
            <field name="name">Customer Return: multi-company</field>
            <field name="model_id" ref="model_customer_return_request"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- ============================================================ -->
        <!-- Record rules - Return Request Line                           -->
        <!-- ============================================================ -->
        <record id="rule_return_request_line_company" model="ir.rule">
            <field name="name">Customer Return Line: multi-company</field>
            <field name="model_id" ref="model_customer_return_request_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- ============================================================ -->
        <!-- Record rules - Return Reason                                 -->
        <!-- ============================================================ -->
        <record id="rule_return_reason_company" model="ir.rule">
            <field name="name">Customer Return Reason: multi-company</field>
            <field name="model_id" ref="model_customer_return_reason"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
